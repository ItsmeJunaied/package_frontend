# Base URL of the Hono API. No trailing slash.
#
# Local backend:  http://localhost:3000
# Deployed (Render): https://package-backend-riu4.onrender.com
#
# This value is inlined at build time by Vite, so it must be set as an
# environment variable in Vercel (Project -> Settings -> Environment Variables)
# before the build runs — a .env file is not uploaded.
VITE_API_URL=https://package-backend-riu4.onrender.com
